# Copy this file to ".env" and edit. Never commit the real .env file.

# development (default) or production. Production turns on strict safety checks:
# the server refuses to start without a strong SECRET_KEY and HTTPS cookies, and API docs are hidden.
ENV=development

# REQUIRED in production: a random value of 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
TOKEN_MINUTES=120

# Development: a local SQLite file. Production (e.g. Neon): the postgresql://... connection string.
DATABASE_URL=sqlite:///./medimate.db
# Browser origins allowed to call the API (not needed if the site and API share one domain)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies are marked Secure (HTTPS-only) automatically when ENV=production.
# COOKIE_SECURE=true
# Set true ONLY when running behind your own reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated host names this server answers to, e.g. medimate.example.com
ALLOWED_HOSTS=

# Shown in the privacy notice as the contact for questions/complaints (use a real address you read)
CONTACT_EMAIL=
# Number of proxies in front of the app when TRUST_PROXY=true (Render: 1; raise to 2 if everyone shares one IP)
TRUSTED_PROXY_HOPS=1

# Rate limits (in-memory, per server process)
LOGIN_MAX_PER_IP=30
LOGIN_MAX_FAILS=5
REGISTER_MAX_PER_HOUR=10

# true = users can load clearly-labelled SAMPLE records (defaults to false in production)
DEMO_MODE=true

# OPTIONAL external AI (any OpenAI-compatible API). Leave LLM_API_KEY empty
# to use the built-in rule-based chatbot (free, works offline).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
